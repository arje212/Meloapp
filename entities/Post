{
  "name": "Post",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "Post text content"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Post image URLs"
    },
    "mountain_id": {
      "type": "string",
      "description": "Tagged mountain ID"
    },
    "mountain_name": {
      "type": "string",
      "description": "Tagged mountain name"
    },
    "author_name": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "experience",
        "tip",
        "photo",
        "agency_promo",
        "tour_package"
      ],
      "default": "experience"
    },
    "likes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who liked"
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "comment_count": {
      "type": "number",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "reported",
        "hidden",
        "deleted"
      ],
      "default": "active"
    }
  },
  "required": [
    "content",
    "author_name",
    "author_email"
  ]
}