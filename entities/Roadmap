{
  "name": "Roadmap",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "ongoing",
        "completed"
      ],
      "default": "planned"
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "cover_image": {
      "type": "string"
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "mountain_id": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "target_date": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "completed"
            ],
            "default": "planned"
          },
          "completion_photo": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "progress_percent": {
      "type": "number",
      "default": 0
    },
    "target_year": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "user_email"
  ]
}