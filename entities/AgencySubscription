{
  "name": "AgencySubscription",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string"
    },
    "agency_name": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "yearly"
      ],
      "default": "monthly"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected",
        "expired"
      ],
      "default": "pending"
    },
    "payment_proof_url": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "gcash_reference": {
      "type": "string"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "agency_id",
    "plan"
  ]
}