{
  "name": "Agency",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Agency business name"
    },
    "description": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suspended"
      ],
      "default": "pending"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "total_bookings": {
      "type": "number",
      "default": 0
    },
    "gcash_number": {
      "type": "string",
      "description": "Agency GCash account number for receiving payments"
    },
    "gcash_name": {
      "type": "string",
      "description": "GCash account holder name"
    },
    "business_reg_document_path": {
      "type": "string",
      "description": "Private storage path for the agency business registration document"
    },
    "permit_document_path": {
      "type": "string",
      "description": "Private storage path for the agency DOLE or operating permit"
    }
  },
  "required": [
    "name",
    "owner_email"
  ]
}